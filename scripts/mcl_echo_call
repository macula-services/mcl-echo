#!/bin/sh
# The terminal caller for mcl-echo: call mcl-echo/echo in the
# io.macula realm. Before the realm's desk admits the node the call
# resolves no provider; after Admit + issue it answers pong.
#
#   ./scripts/mcl_echo_call [station] [N]
#
# N is how many calls to make IN ONE PROCESS, default 1. It exists to separate
# cold start from steady state: call 1 pays the prelude and resolution, and
# calls 2..N tell you what an echo actually costs once the route is up. The
# summary never averages call 1 into the rest.
#
# The station is the way in to the mesh, and several callers at once
# should each take their own: pinned to one, a fan-out test measures a
# single route many times. Default helsinki; the module lists the rest.
#
# Runs against the BUILT ebin/priv trees (rebar3 compile first) — the
# QUIC NIFs are real files there; an escript archive cannot dlopen them.
#
# TWO THINGS ARE REFUSED RATHER THAN GUESSED, because the interesting
# use of this script is several terminals firing at once and a run that
# differs from its neighbours without saying so costs more than it
# reports:
#
#   * an uncompiled tree. Without it the -pa glob stays literal and erl
#     fails deep inside the boot with nothing naming the real cause.
#   * an unpinned runtime. .tool-versions pins the OTP these beams and
#     their NIFs were built with, and it is NOT the first erl on PATH
#     here; `mise exec' resolves the pinned one, so every caller runs
#     the same VM as every other and as the build.
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ ! -d "$DIR/_build/default/lib/mcl_echo/ebin" ]; then
  echo "mcl_echo is not compiled: $DIR/_build/default/lib/mcl_echo/ebin is missing" >&2
  echo "build it first:  cd $DIR && mise exec -- rebar3 compile" >&2
  exit 3
fi

if ! command -v mise >/dev/null 2>&1; then
  echo "mise not found, and this script will not run erl without it: the OTP" >&2
  echo "pinned in $DIR/.tool-versions is not the first erl on PATH, so an" >&2
  echo "unpinned run would silently use a different VM from the one that" >&2
  echo "built these beams and from the other callers in a fan-out." >&2
  exit 4
fi

# THE RUN IDENTIFIES ITSELF. Six terminals comparing results need to agree on
# which instrument produced them, and the banner used to say that only by
# ACCIDENT: two commits happened to change lines in it, so a paste could be
# sorted into a generation after the fact. An accident is a bad thing to depend
# on. HEAD comes from here because git is the shell's business; the beam md5 is
# computed in the VM from the file it actually loaded, which is the artifact
# that runs rather than the one we think it runs.
#
# `-dirty' is not cosmetic: a sha alone would name a commit whose source is not
# what compiled.
MCL_ECHO_HEAD=$(git -C "$DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)
if [ -n "$(git -C "$DIR" status --porcelain 2>/dev/null)" ]; then
  MCL_ECHO_HEAD="$MCL_ECHO_HEAD-dirty"
fi
export MCL_ECHO_HEAD

# cd first: mise resolves .tool-versions from the working directory.
cd "$DIR"
exec mise exec -- erl -noshell +sbtu +A1 \
  -macula crypto_profile pq_hybrid \
  -pa "$DIR"/_build/default/lib/*/ebin \
  -run mcl_echo_call main -extra "$@"
