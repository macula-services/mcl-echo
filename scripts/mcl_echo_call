#!/bin/sh
# The terminal caller for mcl-echo: call mcl-echo/echo in the
# io.macula realm. Before the realm's desk admits the node the call
# resolves no provider; after Admit + issue it answers pong.
#
# Runs against the BUILT ebin/priv trees (rebar3 compile first) — the
# QUIC NIFs are real files there; an escript archive cannot dlopen them.
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec erl -noshell +sbtu +A1 \
  -macula crypto_profile pq_hybrid -macula puzzle_difficulty 8 \
  -pa "$DIR"/_build/default/lib/*/ebin \
  -run mcl_echo_call main
