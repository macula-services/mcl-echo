#!/bin/sh
# Demo driver for the mcl-echo live service: start / stop / status /
# restart the REAL-realm instance whose boot claim lands on the realm
# operator's Providers desk.
#
# The service runs wherever this script runs (the box with the PQ
# toolchain), boots under org `mcl-echo' in the io.macula realm,
# claims its delegation over the wire, and then waits — with the
# DEMO budget — for the operator to Admit + issue on the desk. The
# desk's box label is the demo's story, set by MCL_BOX (default
# beam02.lab).
#
# Usage:
#   scripts/mcl_echo_demo start     # claim lands; desk shows pending
#   scripts/mcl_echo_demo status    # tail the service log
#   scripts/mcl_echo_demo stop      # kill the service
#   scripts/mcl_echo_demo restart
#
# The run window is ~20 minutes (MCL_LIVE_DEMO=1); `start` again if
# it expires mid-take. The identity at MCL_LIVE_IDENTITY (default
# /tmp/mcl_echo_live_realm.key) persists across restarts, so every
# run is the same node re-claiming.
set -eu

DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PIDFILE=/tmp/mcl_echo_demo.pid
LOGFILE=/tmp/mcl_echo_demo.log
BOX_LABEL=${MCL_BOX:-beam02.lab}
RUN_PATTERN="as live_test eunit --dir test_live"
# The demo node's own id — stable while the identity file lives
# (MCL_LIVE_IDENTITY, default /tmp/mcl_echo_live_realm.key).
NODE_ID=${MCL_NODE_ID:-00466bb80a8dc7cd2564fa5dadb489bfa8e57ca19be4a85f278571f4edcd8e6f}
# Where the realm repo lives on this box (for mesh_ops.exs).
# The box running the realm (reset-realm.sh lives in its compose dir).
REALM_BOX=${MCL_REALM_BOX:-root@macula.io}
REALM_COMPOSE_DIR=${MCL_REALM_COMPOSE_DIR:-/root/macula-portal-compose}

start() {
  stop || true
  cd "$DIR"
  MCL_LIVE_REALM=1 MCL_LIVE_DEMO=1 MCL_LIVE_HOLD=1 MCL_BOX="$BOX_LABEL" \
    setsid sh -c "rebar3 $RUN_PATTERN" > "$LOGFILE" 2>&1 &
  echo $! > "$PIDFILE"
  sleep 3
  if kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "mcl-echo demo started (pid $(cat "$PIDFILE"), label $BOX_LABEL)"
    echo "log: $LOGFILE"
  else
    rm -f "$PIDFILE"
    echo "start failed; log: $LOGFILE" >&2
    tail -20 "$LOGFILE" >&2
    exit 1
  fi
}

stop() {
  if [ -f "$PIDFILE" ]; then
    pid=$(cat "$PIDFILE")
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    rm -f "$PIDFILE"
  fi
  pkill -f "$RUN_PATTERN" 2>/dev/null || true
  echo "mcl-echo demo stopped"
}

status() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "running (pid $(cat "$PIDFILE"))"
  else
    echo "not running"
  fi
  echo "--- last log lines: $LOGFILE"
  tail -20 "$LOGFILE" 2>/dev/null || true
}

# The fresh-take reset: wipe the realm's ledger (reset-realm.sh on the
# box) AND tombstone the stale D25 chain in the DHT. The ledger wipe
# alone is not enough — the published delegation lives 6h on the wire
# and the org key survives on the realm's identity volume, so the
# service would still advertise and answer. The withdraw buries the
# wire grant; the next claim starts from a truly empty state.
reset() {
  stop || true
  ssh "$REALM_BOX" "cd $REALM_COMPOSE_DIR && ./scripts/reset-realm.sh"
  sleep 20
  TOKEN=$(ssh "$REALM_BOX" "grep -o '^MACULA_ADMIN_TOKEN=.*' $REALM_COMPOSE_DIR/.env | cut -d= -f2-")
  MACULA_ADMIN_TOKEN="$TOKEN" "$DIR/scripts/mcl_echo_withdraw" "$NODE_ID" mcl-echo
  echo "demo state reset: ledger wiped, wire grant tombstoned — start the service for a fresh claim"
}

case ${1:-status} in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  reset) reset ;;
  *) echo "usage: $0 {start|stop|restart|status|reset}" >&2; exit 2 ;;
esac
