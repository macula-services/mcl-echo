%% test.sys.config — the 11.x test environment: the crypto profile the
%% SDK's start and every key generation read, plus the puzzle difficulty
%% the fleet enforces. Services set the same pair in their own releases.
%% kernel logger at debug: the claim worker's retry reasons log at debug
%% level, and a silent retry loop is exactly the failure mode you need
%% visible during a live rehearsal.
[
    {kernel, [{logger_level, debug}]},
%% ⚠ NO `puzzle_difficulty' HERE. macula 12 (D30) makes it one constant
%% for the fleet, `macula_node_keys:puzzle_difficulty()', and REFUSES a
%% `{macula, puzzle_difficulty, _}' setting at application start whatever
%% the value: a node that set one would believe it had chosen a
%% difficulty that nothing reads.
    {macula, [
        %% ⚠ THE SUITE'S OWN IDENTITY, NOT THE MACHINE'S. Unset, macula 12
        %% reads (and on a fresh machine writes)
        %% `~/.local/share/macula/identity.key' -- the identity of
        %% whatever is running the tests. It refuses to load one whose
        %% profile differs from the profile above, so an unset path makes
        %% the suite depend on a file no test wrote. macula's own
        %% `node_identity/2' exists for exactly this.
        {node_identity_path, "_build/test/node_identity.key"},
        {crypto_profile, pq_hybrid}
    ]}
].
