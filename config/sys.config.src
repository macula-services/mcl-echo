%% Substituted by relx at boot; every ${VAR} must resolve or the node will not
%% start with a malformed term. That is the correct failure: a service with a
%% half-configured realm announces itself where nobody can attribute it, which
%% looks exactly like a healthy node.
[
    {mcl_om, [
        %% Without this, mcl_om_identity:load_node_key/0 returns `undefined'
        %% forever and identity_key/0 stays {error, no_identity_key} -- a
        %% service that declares a handler-bearing capability() then silently
        %% never advertises it, on every republish tick, permanently ("an
        %% ephemeral service cannot sign and is correctly not advertised",
        %% mcl_om_capabilities's own moduledoc). Point it at the mounted
        %% secrets volume.
        {identity_key_path, "/etc/mcl/secrets/identity.key"},
        {health_port,       ${MCL_HEALTH_PORT}},
        {capability_topic,  <<"_mesh.cap.">>},
        %% The wire namespace: `Org/echo'. DEPLOY CONFIG, not code --
        %% one org per service, named after the repo
        %% (PLAN_PROVIDER_AUTHORIZATION_FLOW.md, macula-realm): this
        %% fleet deploys org `mcl-echo' under the io.macula realm; the
        %% realm issues the D25 delegation for this node after
        %% admission. The realm tag is sha256 of the REALM name --
        %% io.macula = abb81b5a614b63551b400b810648c0c8a78efad845442630c94b46cc95d2fcd1 --
        %% and is independent of the org now (the old sha256(org)
        %% realm-name-org convention is gone).
        {org,               <<"${MCL_ORG}">>},
        %% Informational labels the realm's operator sees on this
        %% service's provider-authorization row (never trusted).
        {service_name,      <<"${MCL_SERVICE_NAME}">>},
        {box,               <<"${MCL_BOX}">>},
        %% THE REALM IS AN APPLICATION ENV, NOT A SHELL VARIABLE, and this file
        %% is the only place the two meet. mcl_om_identity:realm() reads
        %% application:get_env(mcl_om, realm); exporting MCL_REALM in the
        %% shell and expecting that to be enough has cost a sibling service an
        %% hour, because nothing translates between the two by itself. The
        %% realm tag is sha256 of the realm name (64-hex) -- for the io.macula
        %% fleet: sha256("io.macula") =
        %% abb81b5a614b63551b400b810648c0c8a78efad845442630c94b46cc95d2fcd1.
        {realm,             <<"${MCL_REALM}">>},
        %% ⚠ THE TRUST ANCHOR, AND IT IS A DIFFERENT THING FROM THE LINE
        %% ABOVE. MCL_REALM is an IDENTIFIER (sha256 of the realm name).
        %% This is the realm's public SIGNING KEY, hex encoded; mcl_om
        %% decodes it and pins it as macula:connect/2's `realm_trust'.
        %%
        %% Without it, every org-namespaced advertisement this service
        %% resolves is refused with `no_realm_key', direct dial answers
        %% `{unresolved, no_trusted_advertisement}', and the boot claim
        %% never reaches the realm: no pending row on the Providers desk,
        %% no delegation, nothing callable. The node stays green and
        %% answers /health throughout. That is exactly what happened on
        %% beam00, and mcl_om >= 0.3.0 now refuses to start a pool without
        %% it rather than letting a service look healthy and be unreachable.
        %%
        %% Public material: it is the half everyone verifies against. It
        %% does NOT belong in the secrets volume.
        {realm_key,         <<"${MCL_REALM_KEY}">>}
    ]},
    %% ==========================================================================
    %% THE PQ CRYPTO PROFILE, WITHOUT WHICH THIS NODE DOES NOT PEER
    %% ==========================================================================
    %%
    %% ⚠ MANDATORY. The macula app starts before the service reads anything,
    %% and without this block it boots on the classical profile while every
    %% PQ station closes the CONNECT/HELLO handshake as puzzle_invalid --
    %% forever, silently. The 11.x client model: a puzzle-8 identity key
    %% (generated and persisted by mcl_om_identity when the path above is
    %% missing) and the pq_hybrid crypto profile every wire signature is
    %% checked under. mcl_om is a library; each service's own release
    %% carries this pair.
    {macula, [
        {crypto_profile, pq_hybrid},
        {puzzle_difficulty, 8}
    ]},
    {kernel, [{logger_level, info}]}
].
