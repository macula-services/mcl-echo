%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_echo.
%%
%% Always-on mcl-echo/io.macula.echo, the mesh's hello-world target every
%% PQ quickstart calls
%%
%% Generated by `rebar3 new mcl_service'. The scaffold boots, joins the mesh
%% and answers /health; the echo capability is the one thing added on top.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) transitively. The service module exports no
    %% store_id/0 + data_dir/0, so mcl_om wires the mesh and starts NO
    %% reckon-db. Export both callbacks to turn this into a CMD/PRJ service that
    %% owns an event store; mcl_om:boot/1 does the wiring before start/1.
    %% ~> 0.37 brings the inbound guard (mcl-om#13): the pipeline wraps
    %% the echo handler, so this service's hand-rolled limits are GONE —
    %% the capability declares them (see mcl_echo_service:capabilities/0)
    %% and the platform enforces them, counts denials, and publishes the
    %% `denials_observed' facts the guardian subscribes to.
    {mcl_om, "~> 0.37"},
    %% The canary for the wire: the echo is the first call in every PQ
    %% quickstart, so its CALL path meets callers from every stack.
    {macula, "~> 13.3"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% The handlers implement `macula_response' and call `macula' directly, but
%% macula comes in only through mcl_om, so it is not in the PLT unless it is
%% named here: dialyzer would report every macula call as unknown (the
%% mcl_service template's line).
{dialyzer, [{plt_extra_apps, [macula]}]}.

{relx, [
    {release, {mcl_echo, "0.2.1"}, [mcl_echo, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {test, [
        {eunit_opts, [{sys_config, "./config/test.sys.config"}]}
    ]},
    %% test_live/*.erl hit a real PQ-fleet station over the network --
    %% genuinely valuable, but NOT safe as an unconditional CI gate:
    %% the fleet is documented, disposable dev infra with no uptime
    %% guarantee, so a station blip must never block an unrelated PR.
    %% Run explicitly:
    %%   rebar3 as live_test eunit --dir test_live
    {live_test, [
        {extra_src_dirs, ["test_live"]},
        {eunit_opts, [{sys_config, "./config/test.sys.config"}]}
    ]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
